{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annota",
  "version": "0.1.0",
  "identifier": "dev.annota.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Annota",
        "width": 1280,
        "height": 720,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": null,
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "shortDescription": "沿选区生成可回溯子文章的本地知识树",
    "longDescription": "Annota 是一个 Windows 优先的本地知识树阅读与编辑应用。"
  }
}
